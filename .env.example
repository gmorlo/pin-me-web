# API origin for the /api/* proxy (next.config.ts). Server-side only, read at build time.
# Local: uvicorn on :8000. Vercel: https://<api>.up.railway.app (required there).
API_ORIGIN=http://localhost:8000

# Portfolio hub (local: portfolio-web on :3000; prod: https://francke.tech)
NEXT_PUBLIC_PORTFOLIO_URL=http://localhost:3000

# Auth cookie is set on this origin via the proxy. On the API set
# WEB_APP_ORIGIN=http://localhost:3001 and
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
